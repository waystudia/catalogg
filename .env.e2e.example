E2E_BASE_URL=http://localhost:5173

E2E_CLIENT_EMAIL=e2e.client@wayyaam.ru
E2E_CLIENT_PASSWORD=
E2E_RESTAURANT_EMAIL=e2e.restaurant@wayyaam.ru
E2E_RESTAURANT_PASSWORD=
E2E_DRIVER_EMAIL=e2e.driver@wayyaam.ru
E2E_DRIVER_PASSWORD=

# Use the same public browser credentials as WayYaam. Never put service_role here.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=

# Optional. Enables npm run e2e:reset through the existing scoped SQL reset.
E2E_DATABASE_URL=
E2E_RECORD_VIDEO=false
E2E_KEEP_OPEN=false
