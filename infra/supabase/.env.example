# Example only. Do not use these placeholder values in production.
POSTGRES_PASSWORD=change-me-with-a-long-random-password
JWT_SECRET=change-me-with-at-least-32-random-bytes
ANON_KEY=generate-from-your-jwt-secret
SERVICE_ROLE_KEY=generate-from-your-jwt-secret
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-with-a-long-random-password
SECRET_KEY_BASE=change-me-with-a-long-random-value
VAULT_ENC_KEY=change-me-with-32-characters

# Public URLs for the self-hosted instance.
SITE_URL=https://catalog.example.ru
API_EXTERNAL_URL=https://supabase.example.ru/auth/v1
PUBLIC_APP_URL=https://catalog.example.ru/catalogg/

# SMTP must be configured by the operator. Do not reuse test SMTP in production.
SMTP_ADMIN_EMAIL=admin@example.ru
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_SENDER_NAME=WayCatalog

# Storage limits and runtime secrets.
STORAGE_FILE_SIZE_LIMIT=52428800
WEB_PUSH_WEBHOOK_SECRET=change-me-with-a-long-random-secret
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:security@example.ru
