{$PROXY_DOMAIN} {
    tls {
        curves x25519
    }

    @supabase_api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /mcp /sso/*

    handle @supabase_api {
        reverse_proxy kong:8000
    }

    handle {
        basic_auth {
            {$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
        }

        reverse_proxy studio:3000
    }

    header -server
}

wayyaam.ru, www.wayyaam.ru {
    tls {
        curves x25519
    }

    root * /srv/wayyaam/current
    encode zstd gzip

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @appShell path / /index.html /sw.js /manifest.webmanifest
    header @appShell Cache-Control "no-cache"

    # Public catalog photos previously pointed directly at Unsplash, which is
    # unreliable for Russian mobile networks. Keep the client on this domain
    # and let the production edge fetch the resized source image.
    handle_path /media/unsplash/* {
        reverse_proxy https://images.unsplash.com {
            header_up Host images.unsplash.com
            header_down Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
        }
    }

    # A missing hashed module must be a real 404. Returning the application
    # shell here makes browsers reject it as JavaScript and leaves a blank PWA.
    handle /assets/* {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    header -server
}
