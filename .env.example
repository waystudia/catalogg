APP_ENV=local
APP_BASE_URL=http://127.0.0.1:5173/catalogg/

# Browser-safe values. These may be bundled into the frontend.
VITE_SUPABASE_URL=https://api.example.ru
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
VITE_YANDEX_TILES_API_KEY=your-browser-restricted-tiles-key

# Server-only values. Never expose these from Vite/browser code.
SUPABASE_URL=https://api.example.ru
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CATALOGG_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_DB_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
SUPABASE_DB_PASSWORD=replace-me

# Edge Function / Web Push secrets.
PUBLIC_APP_URL=http://127.0.0.1:5173/catalogg/
WEB_PUSH_WEBHOOK_SECRET=replace-with-long-random-secret
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-server-only-vapid-private-key
VAPID_SUBJECT=mailto:security@example.invalid

# Yandex Navigator route signing. Keep the RSA private key only in Edge Function secrets.
YANDEX_NAVIGATOR_CLIENT_ID=your-yandex-client-id
YANDEX_NAVIGATOR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
YANDEX_NAVIGATOR_DAILY_TRANSITION_LIMIT=5000
